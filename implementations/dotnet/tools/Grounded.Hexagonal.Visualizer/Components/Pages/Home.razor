@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject ScenarioCatalog ScenarioCatalog
@inject SourceSnippetService SourceSnippetService
@inject IJSRuntime JSRuntime

<PageTitle>Hexagonal Visualizer</PageTitle>

@if (_scenario is null)
{
    <section class="empty-state">
        <h1>No hay escenarios disponibles</h1>
        <p>Agrega un JSON en <code>Data/Scenarios</code>.</p>
    </section>
}
else
{
    var currentStep = CurrentStep;

    <section class="hero">
        <div>
            <div class="eyebrow">VISUAL EXECUTION MAP · @_scenario.FlowType.ToUpperInvariant()</div>
            <h1>@_scenario.Name</h1>
            <p>@_scenario.Description</p>
        </div>

        <div class="hero-id-card">
            <span>Use case activo</span>
            <strong>@_scenario.UseCaseId</strong>
            <small>Escenario @GetScenarioNumber(_scenario) de @_scenarios.Count</small>
        </div>
    </section>

    <section class="scenario-switcher" aria-label="Selector de escenarios">
        @foreach (var scenario in _scenarios)
        {
            var isActive = scenario.Id.Equals(_scenario.Id, StringComparison.OrdinalIgnoreCase);

            <button class="scenario-card @(isActive ? "active" : string.Empty)"
                    @onclick="() => SelectScenarioAsync(scenario.Id)">
                <span class="scenario-icon">@GetScenarioIcon(scenario)</span>
                <span class="scenario-card-copy">
                    <strong>@GetScenarioLabel(scenario)</strong>
                    <small>@scenario.FlowType · @scenario.Trigger</small>
                </span>
                <span class="scenario-state @(scenario.ChangesState ? "mutates" : "readonly")">
                    @(scenario.ChangesState ? "muta estado" : "solo lectura")
                </span>
            </button>
        }
    </section>

    <section class="scenario-facts">
        <div>
            <span>Tipo de flujo</span>
            <strong>@_scenario.FlowType</strong>
        </div>
        <div>
            <span>Trigger</span>
            <strong>@_scenario.Trigger</strong>
        </div>
        <div>
            <span>Cambia estado</span>
            <strong class="@(_scenario.ChangesState ? "fact-yes" : "fact-no")">
                @(_scenario.ChangesState ? "Sí" : "No")
            </strong>
        </div>
        <div class="lesson-fact">
            <span>Idea que demuestra</span>
            <strong>@_scenario.KeyLesson</strong>
        </div>
    </section>

    <section class="visualizer-mode-switcher" aria-label="Modo del visualizador">
        <button class='visualizer-mode-button @(_activeView == "flow" ? "active" : string.Empty)'
                @onclick="ShowFlowView">
            <span>▶</span>
            <div><strong>Execution Flow</strong><small>Runtime + ports + adapters</small></div>
        </button>
        <button class='visualizer-mode-button @(_activeView == "repository" ? "active" : string.Empty)'
                @onclick="ShowRepositoryView">
            <span>⌘</span>
            <div><strong>Repository Map</strong><small>Proyecto → carpeta → archivo → símbolo</small></div>
        </button>
    </section>

    @if (_activeView == "repository")
    {
        <RepositoryExplorer ActiveFilePath="@(currentStep?.Code?.FilePath)"
                            ActiveSymbol="@(currentStep?.Implementation)"
                            ScenarioLabel="@_scenario.NavigationLabel"
                            ActiveStepLabel="@(currentStep?.Title ?? string.Empty)" />
    }
    else
    {
    <section class="context-banner">
        <strong>Cómo leer esta vista:</strong>
        @_scenario.PlaybackNote
    </section>

    <section class="role-glossary" aria-label="Leyenda de roles hexagonales">
        <div class="role-glossary-intro">
            <span>HEXAGONAL ROLE LEGEND</span>
            <strong>Qué significa cada color</strong>
        </div>
        <div class="role-glossary-items">
            <div class="role-glossary-item external"><i></i><span><strong>Exterior</strong><small>Algo fuera del hexágono inicia o recibe el flujo.</small></span></div>
            <div class="role-glossary-item inbound"><i></i><span><strong>Inbound Adapter</strong><small>Traduce HTTP, Worker, CLI, etc. hacia un port.</small></span></div>
            <div class="role-glossary-item core"><i></i><span><strong>Ports + Application</strong><small>Define capacidades y orquesta el caso de uso.</small></span></div>
            <div class="role-glossary-item domain"><i></i><span><strong>Domain</strong><small>Contiene la regla de negocio independiente.</small></span></div>
            <div class="role-glossary-item outbound"><i></i><span><strong>Outbound Adapter</strong><small>Implementa una capacidad que el core necesita afuera.</small></span></div>
        </div>
    </section>

    <section class="playback-toolbar">
        <div class="toolbar-left">
            <div class="playback-actions">
                <button class="primary-button" @onclick="PlayAsync" disabled="@_isPlaying">
                    ▶ Play
                </button>
                <button class="ghost-button" @onclick="Pause" disabled="@(!_isPlaying)">
                    ⏸ Pause
                </button>
                <button class="ghost-button" @onclick="PreviousAsync" disabled="@(_selectedIndex <= 0)">
                    ← Back
                </button>
                <button class="ghost-button" @onclick="NextAsync" disabled="@(_selectedIndex >= _scenario.Steps.Count - 1)">
                    Step →
                </button>
                <button class="ghost-button" @onclick="ResetAsync">
                    ↺ Reset
                </button>
            </div>

            <div class="view-actions" aria-label="Controles de vista">
                <span class="view-actions-label">Vista</span>
                <button class="micro-button" @onclick="ZoomOut" disabled="@(_zoom <= MinZoom)" title="Alejar">−</button>
                <span class="zoom-readout">@GetZoomLabel()</span>
                <button class="micro-button" @onclick="ZoomIn" disabled="@(_zoom >= MaxZoom)" title="Acercar">+</button>
                <button class="micro-button" @onclick="ResetZoom" title="Restablecer zoom">Fit</button>
                <button class="toggle-button @(_focusCurrent ? "active" : string.Empty)" @onclick="ToggleFocusCurrent">
                    ◎ Focus
                </button>
                <button class="toggle-button @(_followCurrent ? "active" : string.Empty)" @onclick="ToggleFollowCurrent">
                    ⇢ Follow
                </button>
            </div>
        </div>

        <div class="toolbar-status-group">
            <div class="interactive-status" title="Esta página sólo se muestra cuando el circuito Interactive Server está activo.">
                <span class="interactive-status-dot"></span>
                Interactive Server activo
            </div>

            <div class="step-counter">
                <strong>Paso @(_selectedIndex + 1)</strong>
                <span>de @_scenario.Steps.Count</span>
            </div>
        </div>
    </section>

    @if (currentStep is not null)
    {
        <section class="payload-journey" aria-label="Transformación del payload">
            <div class="payload-journey-heading">
                <span>PAYLOAD TRANSFORMATION</span>
                <strong>La información cambia de forma al cruzar límites</strong>
            </div>
            <div class="payload-journey-track">
                <div class="journey-state previous @(_selectedIndex == 0 ? "muted" : string.Empty)">
                    <span>Anterior</span>
                    <strong>@(PreviousStep?.Payload.Label ?? "Inicio del flujo")</strong>
                    <code>@(PreviousStep?.Payload.Type ?? "—")</code>
                </div>
                <div class="journey-arrow">→</div>
                <div class="journey-state current @GetPayloadKindClass(currentStep)">
                    <span>Ahora</span>
                    <strong>@currentStep.Payload.Label</strong>
                    <code>@currentStep.Payload.Type</code>
                </div>
                <div class="journey-arrow">→</div>
                <div class="journey-state next @(_selectedIndex >= _scenario.Steps.Count - 1 ? "muted" : string.Empty)">
                    <span>Siguiente</span>
                    <strong>@(NextStep?.Payload.Label ?? "Fin del flujo")</strong>
                    <code>@(NextStep?.Payload.Type ?? "—")</code>
                </div>
            </div>
        </section>
    }

    <div class="workspace-grid">
        <section class="panel flow-panel">
            <div class="panel-heading">
                <div>
                    <div class="panel-kicker">RUNTIME CALL DIRECTION</div>
                    <h2>Flujo ejecutándose</h2>
                </div>
                <div class="flow-heading-meta">
                    <div class="legend-inline role-legend">
                        <span><i class="legend-dot external"></i> exterior</span>
                        <span><i class="legend-dot inbound"></i> entrada</span>
                        <span><i class="legend-dot core"></i> core</span>
                        <span><i class="legend-dot outbound"></i> salida</span>
                        <span><i class="legend-dot domain"></i> domain</span>
                    </div>
                    <span class="pan-hint">✥ Arrastra el fondo para mover el mapa</span>
                </div>
            </div>

            <div class="flow-scroll" id="flowViewport">
                <div class="flow-zoom-stage" style="@GetFlowStageStyle()">
                    <div class="flow-canvas @(_focusCurrent ? "focus-current" : string.Empty)" style="@GetFlowCanvasStyle()">
                    <div class="canvas-caption canvas-caption-top"><strong>START</strong><span>entrada → core → salida</span><strong>END</strong></div>
                    <svg class="flow-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                        <defs>
                            <marker id="runtimeArrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
                                <path d="M 0 0 L 8 4 L 0 8 z" class="runtime-arrow-head" />
                            </marker>
                        </defs>
                        @for (var index = 0; index < _scenario.Steps.Count - 1; index++)
                        {
                            var fromStep = _scenario.Steps[index];
                            var toStep = _scenario.Steps[index + 1];
                            var lineClass = index < _selectedIndex ? "flow-line completed" : "flow-line";

                            <line class="@lineClass"
                                  x1="@GetFlowX(fromStep)"
                                  y1="@fromStep.Position.Y"
                                  x2="@GetFlowX(toStep)"
                                  y2="@toStep.Position.Y"
                                  marker-end="url(#runtimeArrow)" />
                        }
                    </svg>

                    @for (var index = 0; index < _scenario.Steps.Count; index++)
                    {
                        var stepIndex = index;
                        var step = _scenario.Steps[index];

                        <button class="flow-node @GetStepStateClass(index) @GetRoleClass(step) @GetTerminalClass(index)"
                                style="@GetFlowNodeStyle(step)"
                                data-flow-step="@stepIndex"
                                title="@step.Title"
                                @onclick="() => SelectStepFromUiAsync(stepIndex)">
                            @if (index == 0)
                            {
                                <span class="flow-terminal-badge start">START</span>
                            }
                            else if (index == _scenario.Steps.Count - 1)
                            {
                                <span class="flow-terminal-badge end">END</span>
                            }
                            <span class="node-order">@step.Order</span>
                            <span class="node-role">@GetRoleCaption(step)</span>
                            <strong>@step.ShortLabel</strong>
                            <small>@step.Implementation</small>
                        </button>
                    }

                    @if (currentStep is not null)
                    {
                        <div class="payload-packet @GetPayloadKindClass(currentStep)"
                             style="@GetPacketStyle(currentStep)"
                             aria-label="Payload actual">
                            <span></span>
                        </div>
                        <div class="payload-tag" style="@GetPayloadTagStyle(currentStep)">
                            @currentStep.Payload.Label
                        </div>
                    }
                    </div>
                </div>
            </div>
        </section>

        @if (currentStep is not null)
        {
            <aside class="panel inspector-panel">
                <div class="panel-heading compact">
                    <div>
                        <div class="panel-kicker">SELECTED STEP</div>
                        <h2>@currentStep.Title</h2>
                    </div>
                    <span class="architecture-chip">@currentStep.ArchitectureId</span>
                </div>

                <div class="classification-grid">
                    <div>
                        <span>Etapa general</span>
                        <strong>@currentStep.GeneralStage</strong>
                    </div>
                    <div>
                        <span>Rol hexagonal</span>
                        <strong>@currentStep.HexRole</strong>
                    </div>
                    <div>
                        <span>Implementación real</span>
                        <strong>@currentStep.Implementation</strong>
                    </div>
                </div>

                <p class="explanation">@currentStep.Explanation</p>

                <div class="direction-note">
                    <span>Dirección</span>
                    <p>@currentStep.DirectionNote</p>
                </div>

                <div class="payload-card">
                    <div class="payload-heading">
                        <div>
                            <span>Payload en este paso</span>
                            <strong>@currentStep.Payload.Label</strong>
                        </div>
                        <code>@currentStep.Payload.Type</code>
                    </div>
                    <pre>@currentStep.Payload.Preview</pre>
                </div>
            </aside>
        }
    </div>

    <div class="lower-grid">
        <section class="panel code-panel">
            <div class="panel-heading compact">
                <div>
                    <div class="panel-kicker">REAL SOURCE · READ ONLY</div>
                    <h2>Código relevante</h2>
                </div>
            </div>

            @if (_snippet.IsAvailable)
            {
                <div class="file-breadcrumb" title="@_snippet.FilePath">
                    @foreach (var part in GetPathSegments(_snippet.FilePath))
                    {
                        <span>@part</span>
                    }
                </div>

                <div class="code-window">
                    @foreach (var line in _snippet.Lines)
                    {
                        <div class="code-line">
                            <span class="line-number">@line.Number</span>
                            <code>@line.Text</code>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="code-empty">
                    <strong>Sin snippet C# para este paso.</strong>
                    <p>@_snippet.Message</p>
                </div>
            }
        </section>

        <section class="panel repository-panel">
            <div class="panel-heading compact">
                <div>
                    <div class="panel-kicker">COMPILE-TIME DEPENDENCY DIRECTION</div>
                    <h2>Mapa físico de proyectos</h2>
                </div>
            </div>

            <p class="repository-help">
                Estas flechas muestran quién depende de quién en código. No deben confundirse con el recorrido de runtime de arriba.
            </p>

            <div class="project-map">
                <svg class="project-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                        <marker id="dependencyArrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto" markerUnits="strokeWidth">
                            <path d="M 0 0 L 7 3.5 L 0 7 z" class="dependency-arrow-head" />
                        </marker>
                    </defs>
                    @foreach (var edge in _scenario.ProjectEdges)
                    {
                        var fromNode = FindProject(edge.From);
                        var toNode = FindProject(edge.To);

                        if (fromNode is not null && toNode is not null)
                        {
                            <line class="project-line @(IsProjectEdgeActive(edge) ? "active" : string.Empty)"
                                  x1="@fromNode.X"
                                  y1="@fromNode.Y"
                                  x2="@toNode.X"
                                  y2="@toNode.Y"
                                  marker-end="url(#dependencyArrow)" />
                        }
                    }
                </svg>

                @foreach (var project in _scenario.Projects)
                {
                    <div class="project-node @(IsProjectActive(project) ? "active" : string.Empty)"
                         style="@GetProjectStyle(project)">
                        <strong>@project.ShortName</strong>
                        <span>@project.Responsibility</span>
                    </div>
                }
            </div>

            @if (currentStep?.Code is not null)
            {
                <div class="current-file-card">
                    <span>Archivo activo</span>
                    <code>@currentStep.Code.FilePath</code>
                </div>
            }
            else
            {
                <div class="current-file-card muted">
                    <span>Archivo activo</span>
                    <code>— paso externo / conceptual —</code>
                </div>
            }

            <div class="source-path-section">
                <div class="source-path-heading">
                    <div>
                        <span>ACTIVE SOURCE PATH</span>
                        <strong>Del repositorio al símbolo que participa ahora</strong>
                    </div>
                    <small>Sin alterar el proyecto observado</small>
                </div>

                <div class="source-path-map">
                    @foreach (var pathNode in GetActivePathNodes())
                    {
                        <div class="source-path-node @pathNode.Kind">
                            <span>@GetPathNodeIcon(pathNode.Kind)</span>
                            <div>
                                <small>@GetPathNodeCaption(pathNode.Kind)</small>
                                <strong>@pathNode.Label</strong>
                            </div>
                        </div>

                        @if (!pathNode.IsLast)
                        {
                            <div class="source-path-connector">→</div>
                        }
                    }
                </div>
            </div>
        </section>
    </div>

    <section class="reading-guide">
        <div>
            <span class="guide-number">01</span>
            <strong>Arriba: runtime</strong>
            <p>Sigue el paquete para ver por dónde pasa la información durante @_scenario.NavigationLabel.</p>
        </div>
        <div>
            <span class="guide-number">02</span>
            <strong>Derecha: significado</strong>
            <p>Relaciona capa general, rol hexagonal y nombre concreto en nuestro C#.</p>
        </div>
        <div>
            <span class="guide-number">03</span>
            <strong>Abajo: código + dependencias</strong>
            <p>Inspecciona las líneas relevantes y compáralas con la dirección de dependencias entre proyectos.</p>
        </div>
    </section>
    }
}

@code {
    private IReadOnlyList<ArchitectureScenario> _scenarios = [];
    private ArchitectureScenario? _scenario;
    private SourceSnippet _snippet = SourceSnippet.Empty("Selecciona un paso.");
    private string _activeView = "flow";
    private const double MinZoom = 0.72;
    private const double MaxZoom = 1.36;
    private const double ZoomStep = 0.12;
    private const double FlowCanvasWidth = 1120;
    private const double FlowCanvasHeight = 590;
    private const double FlowHorizontalOffset = 3.5;

    private int _selectedIndex;
    private bool _isPlaying;
    private bool _focusCurrent;
    private bool _followCurrent = true;
    private bool _pendingFollow;
    private double _zoom = 1.0;
    private CancellationTokenSource _playbackCancellation = new();

    private FlowStep? CurrentStep =>
        _scenario is null || _scenario.Steps.Count == 0
            ? null
            : _scenario.Steps[Math.Clamp(_selectedIndex, 0, _scenario.Steps.Count - 1)];

    private FlowStep? PreviousStep =>
        _scenario is null || _selectedIndex <= 0
            ? null
            : _scenario.Steps[_selectedIndex - 1];

    private FlowStep? NextStep =>
        _scenario is null || _selectedIndex >= _scenario.Steps.Count - 1
            ? null
            : _scenario.Steps[_selectedIndex + 1];

    protected override async Task OnInitializedAsync()
    {
        _scenarios = await ScenarioCatalog.GetAllAsync();
        _scenario = _scenarios.FirstOrDefault();

        if (_scenario is not null && _scenario.Steps.Count > 0)
        {
            await SelectStepAsync(0);
        }
    }

    private void ShowFlowView()
    {
        _activeView = "flow";
        _pendingFollow = _followCurrent;
    }

    private void ShowRepositoryView() =>
        _activeView = "repository";

    private async Task SelectScenarioAsync(string scenarioId)
    {
        Pause();

        _scenario = _scenarios.FirstOrDefault(
            scenario => scenario.Id.Equals(
                scenarioId,
                StringComparison.OrdinalIgnoreCase));

        if (_scenario is not null && _scenario.Steps.Count > 0)
        {
            await SelectStepAsync(0);
        }
    }

    private async Task SelectStepFromUiAsync(int index)
    {
        Pause();
        await SelectStepAsync(index);
    }

    private async Task SelectStepAsync(int index)
    {
        if (_scenario is null || _scenario.Steps.Count == 0)
        {
            return;
        }

        _selectedIndex = Math.Clamp(
            index,
            0,
            _scenario.Steps.Count - 1);

        _snippet = await SourceSnippetService.ReadAsync(
            _scenario.Steps[_selectedIndex].Code);

        _pendingFollow = _followCurrent;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_activeView == "flow")
            {
                await JSRuntime.InvokeVoidAsync(
                    "hexVisualizer.enableFlowPan",
                    "flowViewport");
            }

            if (!_pendingFollow || _activeView != "flow")
            {
                return;
            }

            _pendingFollow = false;

            await JSRuntime.InvokeVoidAsync(
                "hexVisualizer.scrollStepIntoView",
                _selectedIndex);
        }
        catch (JSDisconnectedException)
        {
            // The browser closed while the Interactive Server circuit was active.
        }
        catch (InvalidOperationException)
        {
            // The JS runtime can be unavailable while the component is being disposed.
        }
    }

    private async Task PlayAsync()
    {
        if (_scenario is null ||
            _scenario.Steps.Count == 0 ||
            _isPlaying)
        {
            return;
        }

        if (_selectedIndex >= _scenario.Steps.Count - 1)
        {
            await SelectStepAsync(0);
        }

        _playbackCancellation.Dispose();
        _playbackCancellation = new CancellationTokenSource();
        var cancellationToken = _playbackCancellation.Token;
        _isPlaying = true;

        try
        {
            while (_isPlaying &&
                   _scenario is not null &&
                   _selectedIndex < _scenario.Steps.Count - 1)
            {
                await Task.Delay(
                    TimeSpan.FromMilliseconds(1150),
                    cancellationToken);

                if (!_isPlaying || cancellationToken.IsCancellationRequested)
                {
                    break;
                }

                await SelectStepAsync(_selectedIndex + 1);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Pause and manual navigation intentionally cancel playback.
        }
        finally
        {
            _isPlaying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Pause()
    {
        _isPlaying = false;
        _playbackCancellation.Cancel();
    }

    private async Task PreviousAsync()
    {
        Pause();
        await SelectStepAsync(_selectedIndex - 1);
    }

    private async Task NextAsync()
    {
        Pause();
        await SelectStepAsync(_selectedIndex + 1);
    }

    private async Task ResetAsync()
    {
        Pause();
        await SelectStepAsync(0);
    }

    private void ZoomIn() =>
        _zoom = Math.Min(MaxZoom, _zoom + ZoomStep);

    private void ZoomOut() =>
        _zoom = Math.Max(MinZoom, _zoom - ZoomStep);

    private void ResetZoom() =>
        _zoom = 1.0;

    private void ToggleFocusCurrent() =>
        _focusCurrent = !_focusCurrent;

    private void ToggleFollowCurrent()
    {
        _followCurrent = !_followCurrent;
        _pendingFollow = _followCurrent;
    }

    private string GetZoomLabel() =>
        $"{Math.Round(_zoom * 100):0}%";

    private string GetFlowStageStyle()
    {
        var width = FlowCanvasWidth * _zoom;
        var height = FlowCanvasHeight * _zoom;

        return
            $"width:{width.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;" +
            $"height:{height.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";
    }

    private string GetFlowCanvasStyle() =>
        $"transform:scale({_zoom.ToString(System.Globalization.CultureInfo.InvariantCulture)});";

    private string GetStepStateClass(int index)
    {
        if (index == _selectedIndex)
        {
            return "active";
        }

        return index < _selectedIndex
            ? "completed"
            : "upcoming";
    }


    private string GetTerminalClass(int index)
    {
        if (_scenario is null || _scenario.Steps.Count == 0)
        {
            return string.Empty;
        }

        if (index == 0)
        {
            return "start-node";
        }

        return index == _scenario.Steps.Count - 1
            ? "end-node"
            : string.Empty;
    }

    private static string GetRoleClass(FlowStep step)
    {
        var role = step.HexRole.ToLowerInvariant();
        var stage = step.GeneralStage.ToLowerInvariant();

        if (stage.Contains("exterior", StringComparison.Ordinal))
        {
            return "role-external";
        }

        if (role.Contains("inbound adapter", StringComparison.Ordinal))
        {
            return "role-inbound";
        }

        if (role.Contains("outbound adapter", StringComparison.Ordinal))
        {
            return "role-outbound";
        }

        if (role.Contains("domain", StringComparison.Ordinal) ||
            stage.Equals("domain", StringComparison.Ordinal))
        {
            return "role-domain";
        }

        return "role-core";
    }

    private static string GetRoleCaption(FlowStep step)
    {
        var role = step.HexRole.ToLowerInvariant();

        if (role.Contains("inbound adapter", StringComparison.Ordinal)) return "IN ADAPTER";
        if (role.Contains("inbound port", StringComparison.Ordinal) || role.Contains("input port", StringComparison.Ordinal)) return "INPUT PORT";
        if (role.Contains("outbound adapter", StringComparison.Ordinal)) return "OUT ADAPTER";
        if (role.Contains("outbound port", StringComparison.Ordinal) || role.Contains("output port", StringComparison.Ordinal)) return "OUTPUT PORT";
        if (role.Contains("domain", StringComparison.Ordinal)) return "DOMAIN";
        if (role.Contains("use case", StringComparison.Ordinal)) return "APPLICATION";
        return "EXTERNAL";
    }

    private static string GetPayloadKindClass(FlowStep step)
    {
        var value = $"{step.Payload.Label} {step.Payload.Type} {step.HexRole}".ToLowerInvariant();

        if (value.Contains("json", StringComparison.Ordinal) ||
            value.Contains("http", StringComparison.Ordinal))
        {
            return "payload-http";
        }

        if (value.Contains("command", StringComparison.Ordinal) ||
            value.Contains("query", StringComparison.Ordinal))
        {
            return "payload-message";
        }

        if (value.Contains("sqlite", StringComparison.Ordinal) ||
            value.Contains("repository", StringComparison.Ordinal) ||
            value.Contains("dbcontext", StringComparison.Ordinal))
        {
            return "payload-storage";
        }

        if (value.Contains("domain", StringComparison.Ordinal) ||
            value.Contains("inventory", StringComparison.Ordinal) ||
            value.Contains("food", StringComparison.Ordinal) ||
            value.Contains("recipe", StringComparison.Ordinal))
        {
            return "payload-domain";
        }

        if (value.Contains("result", StringComparison.Ordinal) ||
            value.Contains("response", StringComparison.Ordinal))
        {
            return "payload-result";
        }

        return "payload-generic";
    }


    private int GetScenarioNumber(ArchitectureScenario scenario)
    {
        for (var index = 0; index < _scenarios.Count; index++)
        {
            if (_scenarios[index].Id.Equals(
                    scenario.Id,
                    StringComparison.OrdinalIgnoreCase))
            {
                return index + 1;
            }
        }

        return 0;
    }

    private static string GetScenarioIcon(ArchitectureScenario scenario)
    {
        if (scenario.FlowType.Contains(
                "Query",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Q";
        }

        if (scenario.FlowType.Contains(
                "Background",
                StringComparison.OrdinalIgnoreCase))
        {
            return "W";
        }

        return "C";
    }

    private static string GetScenarioLabel(ArchitectureScenario scenario) =>
        string.IsNullOrWhiteSpace(scenario.NavigationLabel)
            ? scenario.Name
            : scenario.NavigationLabel;

    private static double GetFlowX(FlowStep step) =>
        Math.Min(96.0, step.Position.X + FlowHorizontalOffset);

    private static string GetFlowNodeStyle(FlowStep step) =>
        $"left:{GetFlowX(step).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;" +
        $"top:{step.Position.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    private static string GetPacketStyle(FlowStep step) =>
        $"left:{GetFlowX(step).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;" +
        $"top:{step.Position.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    private static string GetPayloadTagStyle(FlowStep step)
    {
        var top = step.Position.Y < 70
            ? step.Position.Y + 9
            : step.Position.Y - 11;

        return
            $"left:{GetFlowX(step).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;" +
            $"top:{top.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

    private static string GetProjectStyle(ProjectNode project) =>
        $"left:{project.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;" +
        $"top:{project.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    private ProjectNode? FindProject(string id) =>
        _scenario?.Projects.FirstOrDefault(
            project => project.Id.Equals(
                id,
                StringComparison.OrdinalIgnoreCase));

    private bool IsProjectActive(ProjectNode project)
    {
        var filePath = CurrentStep?.Code?.FilePath;

        return !string.IsNullOrWhiteSpace(filePath) &&
               filePath.StartsWith(
                   project.PathPrefix,
                   StringComparison.OrdinalIgnoreCase);
    }

    private bool IsProjectEdgeActive(ProjectEdge edge)
    {
        var activeProject = _scenario?.Projects.FirstOrDefault(IsProjectActive);

        if (activeProject is null)
        {
            return false;
        }

        return edge.From.Equals(activeProject.Id, StringComparison.OrdinalIgnoreCase) ||
               edge.To.Equals(activeProject.Id, StringComparison.OrdinalIgnoreCase);
    }

    private IReadOnlyList<ActivePathNode> GetActivePathNodes()
    {
        var currentStep = CurrentStep;
        var filePath = currentStep?.Code?.FilePath;

        if (string.IsNullOrWhiteSpace(filePath))
        {
            return
            [
                new ActivePathNode("Exterior / conceptual", "external", true)
            ];
        }

        var segments = GetPathSegments(filePath);
        var nodes = new List<ActivePathNode>();

        for (var index = 0; index < segments.Count; index++)
        {
            var segment = segments[index];
            var isLastFile = index == segments.Count - 1;
            var kind = index switch
            {
                0 => "root",
                1 => "project",
                _ when isLastFile => "file",
                _ => "folder"
            };

            nodes.Add(new ActivePathNode(segment, kind, false));
        }

        if (!string.IsNullOrWhiteSpace(currentStep?.Implementation))
        {
            nodes.Add(new ActivePathNode(currentStep.Implementation, "symbol", true));
        }
        else if (nodes.Count > 0)
        {
            nodes[^1] = new ActivePathNode(nodes[^1].Label, nodes[^1].Kind, true);
        }

        return nodes;
    }

    private static string GetPathNodeIcon(string kind) =>
        kind switch
        {
            "root" => "⌂",
            "project" => "◇",
            "folder" => "▱",
            "file" => "▤",
            "symbol" => "ƒ",
            _ => "○"
        };

    private static string GetPathNodeCaption(string kind) =>
        kind switch
        {
            "root" => "root",
            "project" => "project",
            "folder" => "folder",
            "file" => "file",
            "symbol" => "C# symbol",
            _ => "outside"
        };

    private sealed record ActivePathNode(
        string Label,
        string Kind,
        bool IsLast);

    private static IReadOnlyList<string> GetPathSegments(string filePath) =>
        filePath.Split(
            '/',
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    public void Dispose()
    {
        _playbackCancellation.Cancel();
        _playbackCancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
